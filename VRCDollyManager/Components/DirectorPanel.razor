@using VRCDollyManager.Models
@using VRCDollyManager.Services
@inject DollyFileWatcherService DollyService
@inject DollyChainService ChainService
@inject DollyChainPlayer ChainPlayer
@implements IDisposable

<div class="dolly-details-header">
    <div class="dolly-details-header-container">
        <input list="dolly-chains" placeholder="Chain" value="@_chainName" @onchange="OnChainNameChanged"/>
        <datalist id="dolly-chains">
            @foreach (var name in _chainNames)
            {
                <option value="@name"></option>
            }
        </datalist>
        <button class="move-up" type="button" @onclick="MoveUp" disabled="@(SelectedIndex <= 0)">
            <Blazicon Svg="Lucide.ChevronUp"/>
        </button>
        <button class="move-down" type="button" @onclick="MoveDown" disabled="@(SelectedIndex < 0 || SelectedIndex == _chain.Count - 1)">
            <Blazicon Svg="Lucide.ChevronDown"/>
        </button>
        <button class="remove" type="button" @onclick="RemoveDolly" disabled="@(SelectedIndex < 0)">
            <Blazicon Svg="Lucide.X"/>
        </button>
    </div>
</div>
<div class="dolly-details-body">
    <ul class="dolly-list">
        @foreach (var entry in _chain)
        {
            <li class="dolly-item @(entry.Id == _selectedId ? "selected" : "") @(entry.Id == ChainPlayer.CurrentId ? "playing" : "")"
                @onclick="() => Select(entry)">
                <span>@entry.Dolly.GetDisplayName()</span>
                @if (entry.Id == ChainPlayer.CurrentId)
                {
                    <Blazicon Svg="Lucide.Play"/>
                }
            </li>
        }
    </ul>
</div>

<div class="dolly-details-footer">
    <div class="dolly-details-footer-container" style="gap: 8px;">
        <button class="toggle surface @(ChainPlayer.Shuffle ? "active" : "inactive")" type="button" @onclick="ToggleShuffle">
            <Blazicon Svg="Lucide.Shuffle"/>
        </button>
        <button class="toggle surface inactive" type="button" @onclick="ChainPlayer.Previous" disabled="@(!ChainPlayer.IsRunning)">
            <Blazicon Svg="Lucide.SkipBack"/>
        </button>
        <button class="toggle surface @(ChainPlayer.IsRunning ? "active" : "inactive")" type="button" @onclick="TogglePlay" disabled="@(_chain.Count == 0)">
            <Blazicon Svg="@(ChainPlayer.IsRunning ? Lucide.Square : Lucide.Play)"/>
        </button>
        <button class="toggle surface inactive" type="button" @onclick="ChainPlayer.Next" disabled="@(!ChainPlayer.IsRunning)">
            <Blazicon Svg="Lucide.SkipForward"/>
        </button>
        <button class="toggle surface @(ChainPlayer.Loop != ChainLoopMode.None ? "active" : "inactive")" type="button" @onclick="CycleLoop">
            <Blazicon Svg="@(ChainPlayer.Loop == ChainLoopMode.One ? Lucide.Repeat1 : Lucide.Repeat)"/>
        </button>
        <button class="toggle surface @(ChainPlayer.LookAtMe ? "active" : "inactive")" type="button" @onclick="ToggleLookAtMe">
            <Blazicon Svg="Lucide.ScanFace"/>
        </button>
    </div>
</div>

@code
{
    private List<DirectorDolly> _chain = new();
    private List<string> _chainNames = new();
    private string _chainName = string.Empty;
    private Guid? _selectedId;

    private int SelectedIndex => _chain.FindIndex(d => d.Id == _selectedId);

    protected override async Task OnInitializedAsync()
    {
        DollyService.DollyChanged += OnDollyChanged;
        ChainPlayer.StateChanged += OnChainPlayerStateChanged;

        _chainNames = ChainService.GetChainNames();
        if (_chainNames.Count > 0) await LoadChainAsync(_chainNames[0]);
    }

    public void Queue(Dolly dolly)
    {
        _chain.Add(new DirectorDolly(dolly));
        Save();
        InvokeAsync(StateHasChanged);
    }

    private async Task OnChainNameChanged(ChangeEventArgs e)
    {
        var name = (e.Value as string ?? string.Empty).Trim();
        var existing = _chainNames.FirstOrDefault(n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            await LoadChainAsync(existing);
            return;
        }

        // A new name saves the current list under it.
        _chainName = name;
        Save();
    }

    private async Task LoadChainAsync(string name)
    {
        var chain = ChainService.GetChain(name);
        if (chain == null) return;

        var entries = new List<DirectorDolly>();
        foreach (var fileName in chain.Dollies)
        {
            // The file watcher may not have indexed every file yet; the name alone is enough to play it.
            var dolly = await DollyService.GetDollyByNameAsync(fileName) ?? new Dolly { Name = fileName };
            entries.Add(new DirectorDolly(dolly));
        }

        _chainName = chain.Name;
        _chain = entries;
        _selectedId = null;
        ChainPlayer.LookAtMe = chain.LookAtMe;
    }

    private void Save()
    {
        if (string.IsNullOrEmpty(_chainName)) return;

        ChainService.SaveChain(new DollyChain
        {
            Name = _chainName,
            Dollies = _chain.Select(d => d.Dolly.Name).ToList(),
            LookAtMe = ChainPlayer.LookAtMe
        });
        _chainNames = ChainService.GetChainNames();
    }

    private void Select(DirectorDolly entry) =>
        _selectedId = entry.Id == _selectedId ? null : entry.Id;

    private void MoveUp() => Swap(SelectedIndex, SelectedIndex - 1);

    private void MoveDown() => Swap(SelectedIndex, SelectedIndex + 1);

    private void Swap(int a, int b)
    {
        if (a < 0 || b < 0 || a >= _chain.Count || b >= _chain.Count) return;
        (_chain[a], _chain[b]) = (_chain[b], _chain[a]);
        Save();
    }

    private void RemoveDolly()
    {
        var index = SelectedIndex;
        if (index < 0) return;
        _chain.RemoveAt(index);
        _selectedId = null;
        Save();
    }

    private async Task TogglePlay()
    {
        if (ChainPlayer.IsRunning)
        {
            ChainPlayer.Stop();
            return;
        }

        await ChainPlayer.StartAsync(_chain, Math.Max(SelectedIndex, 0));
    }

    private void ToggleShuffle() => ChainPlayer.Shuffle = !ChainPlayer.Shuffle;

    private void ToggleLookAtMe()
    {
        ChainPlayer.LookAtMe = !ChainPlayer.LookAtMe;
        Save();
    }

    private void CycleLoop() => ChainPlayer.Loop = ChainPlayer.Loop switch
    {
        ChainLoopMode.None => ChainLoopMode.All,
        ChainLoopMode.All => ChainLoopMode.One,
        _ => ChainLoopMode.None
    };

    private void OnDollyChanged(object? sender, DollyChangedEventArgs e)
    {
        if (e.ChangeType != DollyChangeType.Removed) return;

        InvokeAsync(() =>
        {
            if (_chain.RemoveAll(d => d.Dolly.Name == e.FileName) == 0) return;
            Save();
            StateHasChanged();
        });
    }

    private void OnChainPlayerStateChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DollyService.DollyChanged -= OnDollyChanged;
        ChainPlayer.StateChanged -= OnChainPlayerStateChanged;
    }
}
